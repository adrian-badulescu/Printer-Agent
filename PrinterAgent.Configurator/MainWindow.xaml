<Window x:Class="PrinterAgent.Configurator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="URS Printer Agent — Configurator"
        Height="580"
        Width="720"
        MinHeight="480"
        MinWidth="560"
        WindowStartupLocation="CenterScreen">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Padding="12,10" Background="#F3F3F3" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="FooterStatusText"
                   VerticalAlignment="Center"
                   TextWrapping="Wrap"
                   Foreground="#333" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="BackButton"
                  Width="100"
                  Margin="0,0,8,0"
                  Padding="8,4"
                  Click="BackButton_OnClick" />
          <Button x:Name="NextButton"
                  Width="100"
                  Padding="8,4"
                  IsDefault="True"
                  Click="NextButton_OnClick" />
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
      <StackPanel>

        <StackPanel x:Name="StepEnrollmentPanel">
          <TextBlock x:Name="Step1TitleText" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />
          <TextBlock x:Name="Step1DescriptionText" TextWrapping="Wrap" Margin="0,0,0,16" Foreground="#444" />
          <Label x:Name="EnrollmentCodeLabel" Target="{Binding ElementName=EnrollmentCodeBox}" />
          <TextBox x:Name="EnrollmentCodeBox"
                   MaxLength="10"
                   FontSize="15"
                   Padding="8"
                   Margin="0,0,0,8" />
          <TextBlock x:Name="EnrollmentHintText"
                     TextWrapping="Wrap"
                     Foreground="#666"
                     FontSize="12" />
          <TextBlock x:Name="AgentJsonPathText"
                     TextWrapping="Wrap"
                     FontFamily="Consolas"
                     FontSize="12"
                     Foreground="#333"
                     Margin="0,12,0,0" />

          <Border x:Name="ExistingPrintersBorderStep0"
                  BorderBrush="#E0E0E0"
                  BorderThickness="1"
                  CornerRadius="4"
                  Padding="12"
                  Margin="0,16,0,0"
                  Visibility="Collapsed">
            <StackPanel>
              <TextBlock Text="{Binding ExistingPrintersTitleText}"
                         FontWeight="SemiBold"
                         FontSize="14"
                         Margin="0,0,0,8" />
              <ItemsControl ItemsSource="{Binding ExistingPrinters}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,4">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <TextBlock FontSize="11" Foreground="#666">
                          <Run Text="{Binding Id, Mode=OneWay}" />
                          <Run Text=" - " />
                          <Run Text="{Binding Endpoint, Mode=OneWay}" />
                        </TextBlock>
                      </StackPanel>
                      <Button Grid.Column="1"
                              Tag="{Binding Id}"
                              Padding="8,4"
                              Click="DeletePrinter_OnClick"
                              Content="{Binding DataContext.DeleteButtonText, RelativeSource={RelativeSource AncestorType=Window}}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel x:Name="StepNetworkPanel" Visibility="Collapsed">
          <TextBlock x:Name="Step2TitleText" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />
          <TextBlock x:Name="Step2DescriptionText" TextWrapping="Wrap" Margin="0,0,0,12" Foreground="#444" />
          <TextBlock x:Name="SetupTypeLabel" FontWeight="SemiBold" Margin="0,0,0,8" />
          <StackPanel Margin="0,0,0,12">
            <RadioButton x:Name="SetupTypeEscPosRadio"
                         GroupName="SetupPrinterType"
                         IsChecked="True"
                         Margin="0,0,0,6"
                         Checked="SetupTypeRadio_OnChecked" />
            <RadioButton x:Name="SetupTypeFiscalNetRadio"
                         GroupName="SetupPrinterType"
                         Checked="SetupTypeRadio_OnChecked" />
          </StackPanel>
          <TextBlock x:Name="SetupTypeHintText"
                     TextWrapping="Wrap"
                     Foreground="#666"
                     FontSize="12"
                     Margin="0,0,0,12" />
          <Label x:Name="NicLabel" Target="{Binding ElementName=NicCombo}" />
          <ComboBox x:Name="NicCombo"
                    DisplayMemberPath="Description"
                    Margin="0,0,0,8"
                    SelectionChanged="NicCombo_OnSelectionChanged" />
          <TextBlock x:Name="SubnetSummaryText"
                     TextWrapping="Wrap"
                     Margin="0,0,0,12"
                     FontFamily="Consolas"
                     Foreground="#222" />
          <StackPanel x:Name="EscPosScanPanel">
            <CheckBox x:Name="ScanConsentCheckBox"
                      Margin="0,0,0,12">
              <TextBlock x:Name="ScanConsentText" TextWrapping="Wrap" />
            </CheckBox>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
              <Button x:Name="ScanButton"
                      Padding="12,6"
                      Click="ScanButton_OnClick" />
              <TextBlock x:Name="ScanProgressText"
                         Margin="16,6,0,0"
                         VerticalAlignment="Center"
                         Foreground="#555" />
            </StackPanel>
            <Label x:Name="FoundHostsLabel" Target="{Binding ElementName=FoundHostsList}" />
            <ListBox x:Name="FoundHostsList"
                     MinHeight="140"
                     Margin="0,0,0,8"
                     SelectionChanged="FoundHostsList_OnSelectionChanged" />
          </StackPanel>
        </StackPanel>

        <StackPanel x:Name="StepPrinterPanel" Visibility="Collapsed">
          <TextBlock x:Name="Step3TitleText" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />
          <TextBlock x:Name="SelectedHostText"
                     TextWrapping="Wrap"
                     Margin="0,0,0,12"
                     FontWeight="SemiBold" />
          <Label x:Name="PrinterNameLabel" Target="{Binding ElementName=PrinterNameBox}" />
          <TextBox x:Name="PrinterNameBox"
                   Padding="8"
                   Margin="0,0,0,8"
                   TextChanged="PrinterNameBox_OnTextChanged" />
          <Label x:Name="PrinterIdLabel" Target="{Binding ElementName=PrinterIdBox}" />
          <TextBox x:Name="PrinterIdBox"
                   Padding="8"
                   Margin="0,0,0,4"
                   TextChanged="PrinterIdBox_OnTextChanged" />
          <TextBlock x:Name="PrinterIdHintText"
                     TextWrapping="Wrap"
                     Foreground="#666"
                     FontSize="12"
                     Margin="0,0,0,8" />
          <Label x:Name="PrinterTypeLabel" Target="{Binding ElementName=PrinterTypeCombo}" />
          <ComboBox x:Name="PrinterTypeCombo"
                    Margin="0,0,0,8"
                    SelectionChanged="PrinterTypeCombo_OnSelectionChanged">
            <ComboBoxItem Tag="escpos" />
            <ComboBoxItem Tag="fiscalnet" />
          </ComboBox>
          <Label x:Name="IpAddressLabel" Target="{Binding ElementName=IpAddressBox}" />
          <TextBox x:Name="IpAddressBox"
                   Padding="8"
                   Margin="0,0,0,8" />
          <Label x:Name="PortLabel" Target="{Binding ElementName=PortBox}" />
          <TextBox x:Name="PortBox"
                   Padding="8"
                   Margin="0,0,0,12"
                   Text="9100" />
          <StackPanel x:Name="FiscalSettingsPanel" Visibility="Collapsed" Margin="0,0,0,12">
            <Label x:Name="FiscalVatGroupLabel" Target="{Binding ElementName=FiscalVatGroupBox}" />
            <TextBox x:Name="FiscalVatGroupBox" Text="1" Padding="8" Margin="0,0,0,8" />
            <Label x:Name="FiscalDepartmentLabel" Target="{Binding ElementName=FiscalDepartmentBox}" />
            <TextBox x:Name="FiscalDepartmentBox" Text="1" Padding="8" Margin="0,0,0,8" />
            <Label x:Name="FiscalTimeoutLabel" Target="{Binding ElementName=FiscalTimeoutBox}" />
            <TextBox x:Name="FiscalTimeoutBox" Text="120000" Padding="8" Margin="0,0,0,8" />
            <TextBlock x:Name="FiscalNetHintText" TextWrapping="Wrap" Foreground="#666" FontSize="12" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="TestPrintButton"
                    Padding="12,6"
                    Margin="0,0,8,0"
                    Click="TestPrintButton_OnClick" />
            <Button x:Name="SuggestIdButton"
                    Padding="12,6"
                    Click="SuggestIdButton_OnClick" />
          </StackPanel>
          <TextBlock x:Name="SaveHintText"
                     TextWrapping="Wrap"
                     Foreground="#666"
                     FontSize="12" />
        </StackPanel>

        <StackPanel x:Name="StepDonePanel" Visibility="Collapsed">
          <TextBlock x:Name="Step4TitleText" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />
          <TextBlock x:Name="DoneMessageText"
                     TextWrapping="Wrap"
                     Margin="0,0,0,16"
                     Foreground="#444" />
          <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="OpenProgramDataButton"
                    HorizontalAlignment="Left"
                    Padding="12,6"
                    Margin="0,0,8,0"
                    Click="OpenProgramDataFolder_OnClick" />
            <Button x:Name="RefreshIpButton"
                    Padding="12,6"
                    Margin="0,0,8,0"
                    Click="RefreshIpButton_OnClick" />
            <Button x:Name="AddAnotherPrinterButton"
                    Padding="12,6"
                    Click="AddAnotherPrinterButton_OnClick" />
          </StackPanel>
          <TextBlock x:Name="DoneHintText" TextWrapping="Wrap"
                     Foreground="#666"
                     FontSize="12" />

          <Border x:Name="ExistingPrintersBorderStep3"
                  BorderBrush="#E0E0E0"
                  BorderThickness="1"
                  CornerRadius="4"
                  Padding="12"
                  Margin="0,16,0,0"
                  Visibility="Collapsed">
            <StackPanel>
              <TextBlock Text="{Binding ExistingPrintersTitleText}"
                         FontWeight="SemiBold"
                         FontSize="14"
                         Margin="0,0,0,8" />
              <ItemsControl ItemsSource="{Binding ExistingPrinters}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,4">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <TextBlock FontSize="11" Foreground="#666">
                          <Run Text="{Binding Id, Mode=OneWay}" />
                          <Run Text=" - " />
                          <Run Text="{Binding Endpoint, Mode=OneWay}" />
                        </TextBlock>
                      </StackPanel>
                      <Button Grid.Column="1"
                              Tag="{Binding Id}"
                              Padding="8,4"
                              Click="DeletePrinter_OnClick"
                              Content="{Binding DataContext.DeleteButtonText, RelativeSource={RelativeSource AncestorType=Window}}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>

      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
