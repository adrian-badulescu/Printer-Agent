#!/usr/bin/env bash
set -euo pipefail

# Usage:
#   wg-peer-upsert <agentId> <clientPublicKeyBase64> <allowedIpCidr>
#
# Example:
#   wg-peer-upsert 2d3f... "AbCd...=" "10.8.0.10/32"

AGENT_ID="${1:-}"
CLIENT_PUB="${2:-}"
ALLOWED_IP="${3:-}"

if [[ -z "$AGENT_ID" || -z "$CLIENT_PUB" || -z "$ALLOWED_IP" ]]; then
  echo "usage: wg-peer-upsert <agentId> <clientPublicKeyBase64> <allowedIpCidr>" >&2
  exit 2
fi

WG_IF="wg0"
WG_DIR="/etc/wireguard"
PEERS_DIR="${WG_DIR}/peers.d"
BASE_CONF="${WG_DIR}/${WG_IF}.base.conf"
GEN_CONF="${WG_DIR}/${WG_IF}.generated.conf"

if [[ ! -f "$BASE_CONF" ]]; then
  echo "missing base config: ${BASE_CONF}" >&2
  exit 3
fi

install -d -m 0700 "${PEERS_DIR}"

# Keep peer file path stable for idempotency.
PEER_FILE="${PEERS_DIR}/${AGENT_ID}.conf"
TMP_FILE="${PEER_FILE}.tmp"

cat > "$TMP_FILE" <<EOF
[Peer]
PublicKey = ${CLIENT_PUB}
AllowedIPs = ${ALLOWED_IP}
EOF

chmod 0600 "$TMP_FILE"
mv -f "$TMP_FILE" "$PEER_FILE"

# Generate full config deterministically: base + peers sorted by filename.
TMP_GEN="${GEN_CONF}.tmp"
cp "$BASE_CONF" "$TMP_GEN"
echo "" >> "$TMP_GEN"

if compgen -G "${PEERS_DIR}/*.conf" > /dev/null; then
  # shellcheck disable=SC2012
  for f in $(ls -1 "${PEERS_DIR}"/*.conf | sort); do
    echo "" >> "$TMP_GEN"
    cat "$f" >> "$TMP_GEN"
    echo "" >> "$TMP_GEN"
  done
fi

chmod 0600 "$TMP_GEN"
mv -f "$TMP_GEN" "$GEN_CONF"

# Apply to running interface using syncconf; strip removes non-wg(8) directives.
# Note: requires bash process substitution.
wg syncconf "$WG_IF" <(wg-quick strip "$GEN_CONF")

echo "ok: upserted peer ${AGENT_ID} ${ALLOWED_IP}"

