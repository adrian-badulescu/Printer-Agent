#!/usr/bin/env bash
set -euo pipefail

# Usage:
#   wg-peer-delete <agentId> <clientPublicKeyBase64>
#
# We accept clientPublicKey as an arg only to make backend calls explicit;
# the delete operation itself is keyed by agentId (file name).

AGENT_ID="${1:-}"
CLIENT_PUB="${2:-}"

if [[ -z "$AGENT_ID" || -z "$CLIENT_PUB" ]]; then
  echo "usage: wg-peer-delete <agentId> <clientPublicKeyBase64>" >&2
  exit 2
fi

WG_IF="wg0"
WG_DIR="/etc/wireguard"
PEERS_DIR="${WG_DIR}/peers.d"
BASE_CONF="${WG_DIR}/${WG_IF}.base.conf"
GEN_CONF="${WG_DIR}/${WG_IF}.generated.conf"

if [[ ! -f "$BASE_CONF" ]]; then
  echo "missing base config: ${BASE_CONF}" >&2
  exit 3
fi

PEER_FILE="${PEERS_DIR}/${AGENT_ID}.conf"
rm -f "$PEER_FILE"

# Regenerate config after deletion.
TMP_GEN="${GEN_CONF}.tmp"
cp "$BASE_CONF" "$TMP_GEN"
echo "" >> "$TMP_GEN"

if compgen -G "${PEERS_DIR}/*.conf" > /dev/null; then
  # shellcheck disable=SC2012
  for f in $(ls -1 "${PEERS_DIR}"/*.conf | sort); do
    echo "" >> "$TMP_GEN"
    cat "$f" >> "$TMP_GEN"
    echo "" >> "$TMP_GEN"
  done
fi

chmod 0600 "$TMP_GEN"
mv -f "$TMP_GEN" "$GEN_CONF"

wg syncconf "$WG_IF" <(wg-quick strip "$GEN_CONF")

echo "ok: deleted peer ${AGENT_ID}"

