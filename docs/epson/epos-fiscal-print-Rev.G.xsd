          <xs:maxInclusive value="78" />
          <xs:enumeration value="91" />
          <xs:enumeration value="92" />
          <xs:enumeration value="95" /> <!-- 95 = Data Matrix -->
        </xs:restriction>
      </xs:simpleType>
    </xs:union>
  </xs:simpleType>
  
