<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Package Name="URS Printer Agent" Manufacturer="U.R.S." Version="1.3.0.0" UpgradeCode="780b6db8-23eb-460d-9fa6-2f1d9a2d8a43" Scope="perMachine" Codepage="65001">
    <MajorUpgrade DowngradeErrorMessage="A newer version of URS Printer Agent is already installed." />

    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />

    <!-- WixUI + checkbox Exit: pornește Configuratorul (WixShellExec din Util). -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="!(loc.ExitLaunchConfiguratorCheckbox)" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT" Value="!(loc.ExitLaunchConfiguratorText)" />

    <!-- Tip 18: rulează EXE-ul deja instalat; fără WixUtil / WixShellExec. -->
    <CustomAction Id="LaunchConfigurator"
                  FileRef="ConfiguratorExeFile"
                  ExeCommand=""
                  Execute="immediate"
                  Impersonate="yes"
                  Return="asyncNoWait" />

    <!-- ServiceControl uneori nu elimină serviciul (ex. pachet x64 + msiexec 32-bit). CA amânat, SYSTEM, după StopServices. -->
    <!-- sc delete leaves DeleteFlag=1 until reboot; reg delete removes zombie so ServiceInstall can succeed. -->
    <CustomAction Id="ForceRemoveUrsService"
                  Directory="System64Folder"
                  ExeCommand="cmd.exe /c &quot;sc.exe stop URSPrinterAgent 2&gt;nul &amp; sc.exe delete URSPrinterAgent 2&gt;nul &amp; reg delete HKLM\SYSTEM\CurrentControlSet\Services\URSPrinterAgent /f 2&gt;nul&quot;"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <CustomAction Id="RemoveUrsServiceBeforeInstall"
                  Directory="System64Folder"
                  ExeCommand="cmd.exe /c &quot;sc.exe stop URSPrinterAgent 2&gt;nul &amp; sc.exe delete URSPrinterAgent 2&gt;nul &amp; reg delete HKLM\SYSTEM\CurrentControlSet\Services\URSPrinterAgent /f 2&gt;nul&quot;"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <CustomAction Id="EnsureUrsServiceAutoStart"
                  Directory="System64Folder"
                  ExeCommand="cmd.exe /c sc.exe config URSPrinterAgent start= auto"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <!-- WiX StartServices can fail on zombie DISABLED service; force start after registration. -->
    <CustomAction Id="StartUrsPrinterAgent"
                  Directory="System64Folder"
                  ExeCommand="cmd.exe /c sc.exe start URSPrinterAgent"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="ForceRemoveUrsService" After="StopServices" Condition="REMOVE=&quot;ALL&quot;" />
      <!-- After files on disk, before ServiceInstall: remove DISABLED/DeleteFlag zombie (no manual scripts). -->
      <Custom Action="RemoveUrsServiceBeforeInstall" Before="InstallServices" Condition="NOT REMOVE" />
      <Custom Action="EnsureUrsServiceAutoStart" After="InstallServices" Condition="NOT REMOVE" />
      <Custom Action="StartUrsPrinterAgent" After="StartServices" Condition="NOT REMOVE" />
    </InstallExecuteSequence>

    <UI Id="AgentInstallerUI">
      <ui:WixUI Id="WixUI_Minimal" />
      <Publish Dialog="ExitDialog"
               Control="Finish"
               Event="DoAction"
               Value="LaunchConfigurator"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>

    <!-- Tell WiX where to install -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="URSPrinterAgent" />
    </StandardDirectory>

    <!-- Start Menu folder (per-user). WiX v4 StandardDirectory does not expose CommonProgramMenuFolder. -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AGENTSTARTMENUDIR" Name="URS Printer Agent" />
    </StandardDirectory>

    <!-- Runtime: logs + operator overrides (Configurator writes agent.json here). Factory BackendUrl/Redis ship next to the EXE only. -->
    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="AGENTPROGRAMDATAFOLDER" Name="URSPrinterAgent">
        <Directory Id="AGENTPROGRAMDATALOGS" Name="logs" />
      </Directory>
    </StandardDirectory>

    <ComponentGroup Id="AgentProgramDataComponents" Directory="AGENTPROGRAMDATAFOLDER">
      <Component Id="AgentProgramDataLogsFolder" Guid="a1f2e3d4-c5b6-4789-a012-3456789abcde" Directory="AGENTPROGRAMDATALOGS" Bitness="always64">
        <CreateFolder>
          <util:PermissionEx User="Users" GenericAll="yes" />
        </CreateFolder>
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="AgentComponents" Directory="INSTALLFOLDER">
      <!-- Publish the Worker executable -->
      <Component Id="ServiceExecutable" Guid="c4f9a1b1-2e3d-4c5b-8f7a-1b2c3d4e5f6a" Bitness="always64">
        <!-- In WiX v4, project references expose their TargetDir -->
        <File Id="AgentWorkerExe" Source="$(var.WorkerPublishDir)PrinterAgent.Worker.exe" KeyPath="yes" />
        
        <!-- Install as a Windows Service -->
        <ServiceInstall 
          Id="ServiceInstaller" 
          Type="ownProcess" 
          Name="URSPrinterAgent" 
          DisplayName="URS Printer Agent" 
          Description="Connects to the cloud backend to print restaurant orders." 
          Start="auto" 
          Account="LocalSystem" 
          ErrorControl="normal" />

        <!-- Single ServiceControl: duplicate Remove caused sc delete + DeleteFlag without reg cleanup. -->
        <ServiceControl
          Id="ServiceController"
          Name="URSPrinterAgent"
          Start="install"
          Stop="install;uninstall"
          Remove="uninstall"
          Wait="yes" />
      </Component>
      
      <!-- Include the configuration files -->
      <Component Id="AgentConfig" Guid="a1b2c3d4-e5f6-4a5b-8c7d-9e0f1a2b3c4d" Bitness="always64">
        <File Id="AgentJson" Source="$(var.WorkerPublishDir)agent.json" />
        <File Id="AppSettingsJson" Source="$(var.WorkerPublishDir)appsettings.json" />
      </Component>

      <Component Id="ConfiguratorExe" Guid="b2c3d4e5-f6a7-4b8c-9d0e-1f2a3b4c5d6e" Bitness="always64">
        <File Id="ConfiguratorExeFile" Source="$(var.ConfiguratorPublishDir)PrinterAgent.Configurator.exe" KeyPath="yes">
          <!-- Shortcut lângă EXE (același component = per-machine; Meniul Start singur declanșează ICE cu HKLM). -->
          <Shortcut Id="ConfiguratorInstallDirShortcut"
                    Directory="INSTALLFOLDER"
                    Name="Configure URS Printer Agent"
                    WorkingDirectory="INSTALLFOLDER"
                    Advertise="no"
                    Description="Scan LAN for port 9100 and edit agent.json (EnrollmentCode, printers)." />
        </File>
      </Component>

      <!-- Start Menu shortcut (per-user to satisfy ICE rules). -->
      <Component Id="ConfiguratorStartMenuShortcut" Guid="8d52d087-20e4-4dcb-9b89-5b42b1b34f3c" Directory="AGENTSTARTMENUDIR" Bitness="always64">
        <CreateFolder />
        <Shortcut Id="ConfiguratorStartMenuShortcutLink"
                  Name="URS Printer Agent Configurator"
                  Target="[INSTALLFOLDER]PrinterAgent.Configurator.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Advertise="no"
                  Description="Enroll agent and configure printers." />
        <RemoveFolder Id="RemoveAgentStartMenuDir" On="uninstall" />
        <RegistryValue Root="HKCU"
                       Key="Software\U.R.S.\URSPrinterAgent"
                       Name="StartMenuShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
      
    </ComponentGroup>

    <Feature Id="Main">
      <ComponentGroupRef Id="AgentComponents" />
      <ComponentGroupRef Id="AgentProgramDataComponents" />
    </Feature>
  </Package>
</Wix>
